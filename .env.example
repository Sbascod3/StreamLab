# Copia este archivo como .env y ajusta valores
PORT=3000
RTMP_PORT=1935
# (Opcional) IP o dominio que se muestra en el panel para OBS.
# Si se deja vacío se usa automáticamente el host con el que abres la web.
PUBLIC_HOST=
FFMPEG_PATH=/usr/bin/ffmpeg
# Grabar cada transmisión como VOD (true/false)
RECORD_VOD=true
